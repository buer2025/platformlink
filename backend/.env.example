# 数据库（docker compose 会自动覆盖为 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./platformlink.db

# 后台登录口令（必填，建议 32 位以上随机串：openssl rand -hex 24）
ADMIN_TOKEN=

# Claude（为空时 Agent 使用规则兜底）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 使用中转时填写，例如 https://api.example.com
ANTHROPIC_BASE_URL=

# Telegram：BotFather 获取 token；setWebhook 时带 secret_token=TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# webhook（需公网 HTTPS）或 polling（无公网地址时）
TELEGRAM_MODE=webhook

# 飞书：开放平台 → 应用凭证 / 事件订阅的 Verification Token（不要开启 Encrypt Key）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 企业微信：会话存档拉取进程转发时在请求头 X-Forward-Secret 带上该值
WECOM_CORP_ID=
WECOM_AGENT_SECRET=
WECOM_FORWARD_SECRET=

# 可选调优
# INCIDENT_MERGE_MINUTES=30
# SUPPLIER_REMIND_MINUTES=30
# SUPPLIER_MAX_REMINDERS=2
# 日志库（new-api，只读账号），例如 mysql+aiomysql://ro:pwd@host:3306/new-api；为空时跳过日志查询
LOG_DATABASE_URL=

# Jev 结构化决策（AGTCloud /v1/decisions）：分诊、是否跟进等轻量判断走 Jev（亚秒级），
# 拿不准或失败时回退 Claude。留空则全部用 Claude。默认复用 ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY。
JEV_MODEL=
# JEV_BASE_URL=
# JEV_API_KEY=

# new-api 管理接口（可选）：排查时实时测试上游渠道（GET /api/channel/test/{id}），作为证据清单里的「渠道实测」。
# 令牌在 new-api「个人设置 → 系统访问令牌」生成（需管理员）；新版 new-api 还需要管理员的用户 ID。
# 注意：每次测试会向上游发一次真实请求。
NEWAPI_BASE_URL=
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=

# 操作审计与数据库查询耗时（后台「操作审计」页，仅管理员可见）
# 业务库单条 SQL 超过多少毫秒单独记录为慢查询（0 = 每条都记，量很大）；new-api 日志库的查询每条都记
# SLOW_QUERY_MS=100
# 是否连只读请求（GET）也记录；默认只记写操作、登录、权限拒绝和出错的请求
# AUDIT_READS=false
# 审计、数据库查询、模型调用记录保留天数；0 = 永久保留
# RECORD_RETENTION_DAYS=0
