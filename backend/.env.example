# 数据库（docker compose 会自动覆盖为 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./platformlink.db

# 后台登录口令（必填，建议 32 位以上随机串：openssl rand -hex 24）
ADMIN_TOKEN=

# Claude（为空时 Agent 使用规则兜底）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Telegram：BotFather 获取 token；setWebhook 时带 secret_token=TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# webhook（需公网 HTTPS）或 polling（无公网地址时）
TELEGRAM_MODE=webhook

# 飞书：开放平台 → 应用凭证 / 事件订阅的 Verification Token（不要开启 Encrypt Key）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# 企业微信：会话存档拉取进程转发时在请求头 X-Forward-Secret 带上该值
WECOM_CORP_ID=
WECOM_AGENT_SECRET=
WECOM_FORWARD_SECRET=

# 可选调优
# INCIDENT_MERGE_MINUTES=30
# SUPPLIER_REMIND_MINUTES=30
# SUPPLIER_MAX_REMINDERS=2
